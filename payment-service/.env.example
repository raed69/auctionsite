# ── Service ────────────────────────────────────────────────────────────────
PORT=3006

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Konnect payment gateway ────────────────────────────────────────────────
# Swap these for real credentials to go live — NO code changes required.
KONNECT_API_KEY=your-konnect-api-key
KONNECT_WALLET_ID=your-konnect-wallet-id
KONNECT_API_URL=https://api.preprod.konnect.network/api/v2
# When true, deposits/payments are simulated via /mock-pay without real credentials.
KONNECT_MOCK=true
FRONTEND_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_FAIL_URL=http://localhost:3000/payment/fail
WEBHOOK_URL=http://localhost:3006/payments/webhook

# ── Inter-service ──────────────────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3005
# Must match INTERNAL_SECRET across all services (user/auction/bidding/payment)
INTERNAL_SECRET=
# Must match the JWT_SECRET user-service signs tokens with
JWT_SECRET=

# ── Card vault ─────────────────────────────────────────────────────────────
# AES-256-GCM key (32 bytes, hex) for encrypting saved-card gateway tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CARD_ENCRYPTION_KEY=
